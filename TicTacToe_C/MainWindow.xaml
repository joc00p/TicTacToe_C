<Window x:Class="TicTacToe_C.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic Tac Toe"
        Height="700" Width="460"
        MinHeight="700" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent">

    <!-- Extends DWM Mica material across the entire client area -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      CaptionHeight="32"
                      UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ── Physical cell button ─────────────────────────────────────── -->
        <Style x:Key="CellStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Depth shadow — animates on hover/press -->
                            <Border x:Name="ShadowBorder" CornerRadius="16" Margin="2,4,-2,-4"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CellShadow"
                                                      Color="#000000"
                                                      BlurRadius="14"
                                                      ShadowDepth="5"
                                                      Opacity="0.55"/>
                                </Border.Effect>
                            </Border>

                            <!-- The tile itself — shifts on press -->
                            <Border x:Name="Tile" CornerRadius="16" BorderThickness="1.2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TileShift" Y="0"/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1E2D47" Offset="0"/>
                                        <GradientStop Color="#0D1828" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Specular highlight: bright top edge, dark bottom edge -->
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#10FFFFFF" Offset="0.45"/>
                                        <GradientStop Color="#18000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover: tile rises, shadow deepens -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="22" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="8" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="TileShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="14" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="TileShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <!-- Press: tile sinks down, shadow flattens -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="3" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="5" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="CellShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="1" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Level pill (RadioButton) ─────────────────────────────────── -->
        <Style x:Key="PillStyle" TargetType="RadioButton">
            <Setter Property="Foreground"  Value="#7D8898"/>
            <Setter Property="FontFamily"  Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Focusable"   Value="False"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" BorderThickness="1.2" Padding="4,7">
                            <Border.Background>
                                <SolidColorBrush Color="#0A0F1C" Opacity="0.85"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#1A2540"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BC8CFF" Offset="0"/>
                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1F1440" Offset="0"/>
                                            <GradientStop Color="#110C2A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#BC8CFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value><SolidColorBrush Color="#3D3060"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── First-move pill variants ─────────────────────────────────── -->
        <Style x:Key="PillX" TargetType="RadioButton" BasedOn="{StaticResource PillStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#60CDFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillO" TargetType="RadioButton" BasedOn="{StaticResource PillStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FF6B81"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── New Game button ───────────────────────────────────────────── -->
        <Style x:Key="NewGameStyle" TargetType="Button">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontFamily"  Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="Focusable"   Value="False"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1F6FEB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="BtnGlow"
                                                  Color="#1F6FEB" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnGlow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="26" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.75" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnGlow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="16" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.5" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ── Dark scrim over Mica so content is readable ─────────────────── -->
    <Border Background="#CC07090F">

        <Grid Margin="20,8,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>     <!-- 0  caption space    -->
                <RowDefinition Height="Auto"/>   <!-- 1  title            -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>   <!-- 3  score bar        -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>      <!-- 5  board            -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>   <!-- 7  status           -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>   <!-- 9  controls         -->
            </Grid.RowDefinitions>

            <!-- ── Title ─────────────────────────────────────────────────── -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="Black"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#60CDFF" Offset="0"/>
                            <GradientStop Color="#BC8CFF" Offset="0.5"/>
                            <GradientStop Color="#FF6B81" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    T I C&#x2003;&#x2003;T A C&#x2003;&#x2003;T O E
                </TextBlock>
                <TextBlock Text="Y O U   V S   C O M P U T E R"
                           FontSize="8.5"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           Foreground="#6E7A8A"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ── Score bar ──────────────────────────────────────────────── -->
            <Border Grid.Row="3" CornerRadius="13" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="#0D1525" Opacity="0.88"/>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#25FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="YOU  (X)" FontSize="7.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   Foreground="#6E7A8A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScorePlayer" Text="0" FontSize="30" FontWeight="Bold"
                                   Foreground="#60CDFF" HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                               Margin="0,8" Fill="#1A2540"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="DRAWS" FontSize="7.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   Foreground="#6E7A8A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreDraw" Text="0" FontSize="30" FontWeight="Bold"
                                   Foreground="#6E7A8A" HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right"
                               Margin="0,8" Fill="#1A2540"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="CPU  (O)" FontSize="7.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   Foreground="#6E7A8A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreCpu" Text="0" FontSize="30" FontWeight="Bold"
                                   Foreground="#FF6B81" HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Board + win-line overlay ───────────────────────────────── -->
            <Viewbox Grid.Row="5" Stretch="Uniform">
                <Grid Width="330" Height="330">
                    <UniformGrid x:Name="BoardGrid" Rows="3" Columns="3"/>
                    <!-- Win line drawn here in code -->
                    <Canvas x:Name="WinCanvas" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>

            <!-- ── Status ─────────────────────────────────────────────────── -->
            <TextBlock x:Name="StatusText" Grid.Row="7"
                       Text="Press New Game to start"
                       FontSize="13.5"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontWeight="SemiBold"
                       Foreground="#6E7A8A"
                       HorizontalAlignment="Center"/>

            <!-- ── Controls card ──────────────────────────────────────────── -->
            <Border Grid.Row="9" CornerRadius="14" BorderThickness="1" Padding="14,12">
                <Border.Background>
                    <SolidColorBrush Color="#0D1525" Opacity="0.88"/>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#25FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="D I F F I C U L T Y" FontSize="7.5"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="#6E7A8A" Margin="0,0,0,6"/>
                    <UniformGrid x:Name="LevelGrid" Rows="1" Columns="5" Height="46"/>

                    <Rectangle Height="1" Margin="0,10">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#001A2540" Offset="0"/>
                                <GradientStop Color="#FF1A2540" Offset="0.2"/>
                                <GradientStop Color="#FF1A2540" Offset="0.8"/>
                                <GradientStop Color="#001A2540" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <TextBlock Text="F I R S T   M O V E" FontSize="7.5"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="#6E7A8A" Margin="0,0,0,6"/>
                    <UniformGrid Rows="1" Columns="2" Height="38">
                        <RadioButton x:Name="RbFirstPlayer" Content="You (X)"
                                     Style="{StaticResource PillX}"
                                     GroupName="FirstMove" IsChecked="True"
                                     Margin="0,0,4,0"/>
                        <RadioButton x:Name="RbFirstCpu" Content="CPU (O)"
                                     Style="{StaticResource PillO}"
                                     GroupName="FirstMove"
                                     Margin="4,0,0,0"/>
                    </UniformGrid>

                    <Rectangle Height="1" Margin="0,10">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#001A2540" Offset="0"/>
                                <GradientStop Color="#FF1A2540" Offset="0.2"/>
                                <GradientStop Color="#FF1A2540" Offset="0.8"/>
                                <GradientStop Color="#001A2540" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Button x:Name="BtnNewGame" Content="NEW GAME"
                            Style="{StaticResource NewGameStyle}"
                            Click="NewGame_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
